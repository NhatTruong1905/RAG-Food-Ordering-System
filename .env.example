# =================================================================
# CẤU HÌNH CHO LOCAL HOẶC DEPLOY (RAILWAY) - RAG AI CHATBOT SERVICE
# =================================================================

# 1. Cấu hình Host & Port
# Local: HOST=0.0.0.0, PORT=8000
# Railway: Railway tự động cung cấp biến môi trường $PORT
HOST=0.0.0.0
PORT=8000

# 2. Cấu hình RAG & Chunking
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K=4
SIMILARITY_THRESHOLD=0.2

# 3. Lựa chọn Embedding Provider: auto | tfidf | gemini
EMBEDDING_PROVIDER=auto

# 4. Cấu hình Gemini API Key cho LLM và Embeddings
GEMINI_API_KEY=your_gemini_api_key_here

# 5. Danh sách domain cho phép truy cập qua CORS (phân tách bởi dấu phẩy)
# Đã hỗ trợ sẵn: http://localhost:5000, http://127.0.0.1:5000, https://food-ordering-system-production-1cd8.up.railway.app
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,https://food-ordering-system-production-1cd8.up.railway.app
