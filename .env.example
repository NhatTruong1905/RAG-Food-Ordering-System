# Cấu hình Host & Port
HOST=0.0.0.0
PORT=8000

# Cấu hình RAG
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K=4
SIMILARITY_THRESHOLD=0.2

# Lựa chọn Embedding Provider: auto | tfidf | sentence_transformers | gemini | openai
EMBEDDING_PROVIDER=auto

# Cấu hình API Key nếu muốn dùng Cloud LLMs (Tùy chọn)
GEMINI_API_KEY=
OPENAI_API_KEY=
